# infra 草案模板：复制为 docker/.env.local 后填写真实值，不要提交私密值。
# 私密值只放部署副本 .env.local，本模板仅占位。
# 模板只放变量名、说明和占位符，绝不放真实值。
# 使用：复制为部署副本的 .env.local 后填真实值（.env.local 不提交）。
PROJECT_SLUG=<project_slug>
COMPOSE_PROJECT_NAME=<project_slug>
APP_PORT=<host_port>
PUBLIC_APP_URL=<public_url>
# 宿主绝对路径，必须预先存在（Compose 不静默创建）：
APP_DATA_DIR=<abs_path_to_data_dir>
APP_BACKUP_DIR=<abs_path_to_backup_dir>
IMAGE_TAG=<image_tag>
